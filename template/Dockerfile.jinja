FROM python:{{ python_version }}-slim AS base

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install dependencies in a separate layer so they cache independently of source changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project --no-dev

COPY README.md ./
COPY src ./src
RUN uv sync --locked --no-dev

RUN groupadd --system app \
    && useradd --system --gid app --no-create-home app \
    && chown -R app:app /app
USER app

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/health', timeout=2)" || exit 1

# Runs the `{{ package_slug }}` console script (main:serve), so
# {{ env_prefix }}HOST/{{ env_prefix }}PORT are honored the same way they are
# under `uv run {{ package_slug }}` — unlike invoking uvicorn directly here,
# which would hardcode the bind address regardless of Settings.
CMD ["{{ package_slug }}"]
