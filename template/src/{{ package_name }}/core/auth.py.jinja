"""Azure Entra ID authentication.

`build_azure_scheme` builds the JWT-validation dependency from whatever
`Settings` the container was constructed with (see `bootstrap.build_container`),
rather than from a module-level singleton — that way `create_app(settings=...)`
overrides (used by tests and alternate entrypoints) actually take effect.
`get_current_user` then resolves the caller for a given request by calling
the container's `azure_scheme` directly. It validates the bearer JWT's
signature (against Entra ID's published signing keys), issuer, audience, and
expiry on every call, lazily fetching and caching Entra ID's OpenID
configuration the first time it's needed — see fastapi-azure-auth's
`OpenIdConfig.load_config()` if you'd rather pre-warm that cache during
startup instead (it needs live network access to Microsoft's endpoints,
which is why it isn't wired into `main.py`'s lifespan by default: it would
make every test that builds an app, not just auth tests, depend on that
network call succeeding).

Role checking (`check_role`) is kept separate from identity resolution
(`get_current_user`): it only assumes the resolved caller exposes a `roles`
list, not that the caller came from Entra ID. Swapping in another
JWT-based provider later (e.g. AWS Cognito, Sign in with Apple) means
writing a new identity-resolution dependency to replace `get_current_user` —
`check_role`/`require_role` keep working unchanged.
"""

from __future__ import annotations

from collections.abc import Awaitable, Callable
from typing import Annotated, Protocol

from fastapi import Depends, HTTPException, Request, status
from fastapi.security import SecurityScopes
from fastapi_azure_auth import SingleTenantAzureAuthorizationCodeBearer
from fastapi_azure_auth.user import User

from {{ package_name }}.container import ContainerDep
from {{ package_name }}.core.config import Settings


def build_azure_scheme(settings: Settings) -> SingleTenantAzureAuthorizationCodeBearer:
    """Builds the Azure Entra ID JWT-validation dependency from settings.

    Args:
        settings (Settings): Runtime settings the container was built with.

    Returns:
        SingleTenantAzureAuthorizationCodeBearer: Configured JWT-validation
            dependency.

    Raises:
        RuntimeError: If the tenant or client ID isn't configured.
    """

    if settings.azure_tenant_id is None or settings.azure_client_id is None:
        msg = (
            "{{ env_prefix }}AZURE_TENANT_ID and {{ env_prefix }}AZURE_CLIENT_ID "
            "are required when Azure Entra ID auth is enabled."
        )
        raise RuntimeError(msg)

    scope = f"api://{settings.azure_client_id}/user_impersonation"
    return SingleTenantAzureAuthorizationCodeBearer(
        app_client_id=settings.azure_client_id,
        tenant_id=settings.azure_tenant_id,
        scopes={scope: "user_impersonation"},
    )


async def get_current_user(container: ContainerDep, request: Request) -> User:
    """Resolves the caller by validating the request's bearer JWT.

    Passes empty `SecurityScopes`, matching what FastAPI would auto-inject
    for a plain `Depends(azure_scheme)` with no `Security(..., scopes=[...])`
    declared on the route — this dependency doesn't itself add a scope
    requirement; use `require_role(...)` for authorization instead.

    Args:
        container (ServiceContainer): Application service container, whose
            `azure_scheme` was built from this app's own settings.
        request (Request): Current request, forwarded to `azure_scheme`.

    Returns:
        User: Caller resolved by the container's `azure_scheme`.

    Raises:
        HTTPException: 401 if no caller could be resolved (only reachable if
            `azure_scheme.auto_error` is disabled; it's enabled by default,
            in which case `azure_scheme` itself already raised).
    """

    user = await container.azure_scheme(request, SecurityScopes())
    if user is None:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED, detail="Not authenticated"
        )
    return user


class _HasRoles(Protocol):
    """Anything an identity dependency resolves to that carries app roles."""

    roles: list[str]


def check_role[T: _HasRoles](role: str, user: T) -> T:
    """Checks a resolved caller for a required role.

    Provider-agnostic: works against whatever an identity dependency
    resolves to, as long as it exposes a `roles` list — Entra ID's
    `User.roles`, or the equivalent claim from another OIDC provider.

    Args:
        role (str): Role name to require.
        user (_HasRoles): Caller resolved by an identity dependency.

    Returns:
        _HasRoles: The same caller, once authorized.

    Raises:
        HTTPException: 403 if the caller lacks the required role.
    """

    if role not in user.roles:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail=f"Missing required role: {role}",
        )
    return user


def require_role(role: str) -> Callable[..., Awaitable[User]]:
    """Builds a dependency that requires a specific Entra ID app role.

    App roles are configured on the Entra ID app registration and assigned
    to users/groups/service principals there — see
    https://learn.microsoft.com/en-us/entra/identity-platform/howto-add-app-roles-in-apps

    Args:
        role (str): App role name to require (must match the `roles` claim).

    Returns:
        Callable: FastAPI dependency resolving to the caller if authorized.
    """

    async def _require_role(user: Annotated[User, Depends(get_current_user)]) -> User:
        """Resolves the caller via `get_current_user` and checks their role.

        Args:
            user (User): Caller resolved by `get_current_user`.

        Returns:
            User: The same caller, once authorized.

        Raises:
            HTTPException: 403 if the caller lacks the required role.
        """

        return check_role(role, user)

    return _require_role


# Example role dependency for the demo /auth/admin route below. Add more
# `require_role("...")` bindings the same way for your own roles.
require_admin_role = require_role("Admin")
