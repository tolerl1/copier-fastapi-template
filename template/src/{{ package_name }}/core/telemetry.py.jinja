"""OpenTelemetry bootstrap helpers."""

from __future__ import annotations

from fastapi import FastAPI
from opentelemetry import trace
from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
from opentelemetry.instrumentation.fastapi import FastAPIInstrumentor
from opentelemetry.sdk.resources import DEPLOYMENT_ENVIRONMENT, SERVICE_NAME, Resource
from opentelemetry.sdk.trace import TracerProvider
from opentelemetry.sdk.trace.export import (
    BatchSpanProcessor,
    ConsoleSpanExporter,
    SimpleSpanProcessor,
)

from {{ package_name }}.core.config import Settings

_TRACES_PATH = "v1/traces"


def _resolve_traces_endpoint(otlp_endpoint: str) -> str:
    """Appends the OTLP traces signal path if the endpoint doesn't have one.

    `OTLPSpanExporter` only auto-appends `v1/traces` when it falls back to
    reading `OTEL_EXPORTER_OTLP_ENDPOINT` from the environment; an explicit
    `endpoint=` argument (what this module passes) is used verbatim. Without
    this, a bare collector base URL silently 404s instead of exporting.

    Args:
        otlp_endpoint (str): Configured OTLP endpoint, base URL or full path.

    Returns:
        str: Endpoint guaranteed to end with the traces signal path.
    """

    trimmed = otlp_endpoint.rstrip("/")
    if trimmed.endswith(_TRACES_PATH):
        return otlp_endpoint
    return f"{trimmed}/{_TRACES_PATH}"


def configure_telemetry(app: FastAPI, settings: Settings) -> None:
    """Enables OpenTelemetry tracing for the FastAPI application.

    Args:
        app (FastAPI): Application instance to instrument.
        settings (Settings): Runtime settings.

    Returns:
        None: Instrumentation is applied in-place.
    """

    if not settings.telemetry_enabled:
        return

    provider = TracerProvider(
        resource=Resource.create(
            {
                SERVICE_NAME: settings.app_name,
                DEPLOYMENT_ENVIRONMENT: settings.environment,
            }
        )
    )
    # BatchSpanProcessor suits the network-bound OTLP exporter (batches
    # reduce request overhead); SimpleSpanProcessor exports console spans
    # synchronously instead of from a background thread that can outlive a
    # short-lived process (e.g. a test run) and log write-after-close errors.
    processor = (
        BatchSpanProcessor(
            OTLPSpanExporter(endpoint=_resolve_traces_endpoint(settings.otlp_endpoint))
        )
        if settings.otlp_endpoint
        else SimpleSpanProcessor(ConsoleSpanExporter())
    )
    provider.add_span_processor(processor)
    trace.set_tracer_provider(provider)
    FastAPIInstrumentor.instrument_app(app, tracer_provider=provider)
