from __future__ import annotations

from {{ package_name }}.api.models import ScopeDefinition, ScopeRegistry
from {{ package_name }}.api.services import HealthService, {% if include_example_endpoint %}ItemService, {% endif %}TaskDispatcher
from {{ package_name }}.container import ServiceContainer
{% if enable_azure_auth %}
from {{ package_name }}.core.auth import build_azure_scheme
{% endif %}
from {{ package_name }}.core.config import Settings
from {{ package_name }}.database.queues import create_task_queue
{% if include_example_endpoint %}
from {{ package_name }}.database.repositories import SqlAlchemyItemRepository
{% endif %}
from {{ package_name }}.database.session import DatabaseSessionManager


def build_container(settings: Settings | None = None) -> ServiceContainer:
    """Builds the application service container.

    Args:
        settings (Settings | None): Optional runtime settings override.

    Returns:
        ServiceContainer: Initialized service container.
    """

    resolved_settings = settings or Settings()
    scope_registry = ScopeRegistry(
        [
            ScopeDefinition(name=scope.name, description=scope.description)
            for scope in resolved_settings.scopes
        ]
    )
    session_manager = DatabaseSessionManager(
        resolved_settings.database_url,
        pool_size=resolved_settings.db_pool_size,
        max_overflow=resolved_settings.db_max_overflow,
    )
    task_queue = create_task_queue(resolved_settings)
    return ServiceContainer(
        settings=resolved_settings,
        session_manager=session_manager,
        scope_registry=scope_registry,
        health_service=HealthService(
            resolved_settings, task_queue, scope_registry, session_manager
        ),
{% if include_example_endpoint %}
        item_service=ItemService(SqlAlchemyItemRepository()),
{% endif %}
        task_dispatcher=TaskDispatcher(
            queue=task_queue,
            queue_backend=resolved_settings.queue_backend,
            scope_registry=scope_registry,
        ),
        task_queue=task_queue,
{% if enable_azure_auth %}
        azure_scheme=build_azure_scheme(resolved_settings),
{% endif %}
    )
