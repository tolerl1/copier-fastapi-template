"""The application service container's shape.

Deliberately separate from `bootstrap.py`: this module only defines what a
`ServiceContainer` looks like, so request-time code
(`application/dependencies.py`) can depend on the type without pulling in
the whole service graph that `bootstrap.build_container` wires up. Import
`bootstrap` only where a container actually needs to be built (currently
just `main.py`).
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import TYPE_CHECKING, Annotated, TypedDict, cast

from fastapi import Depends, Request

if TYPE_CHECKING:
    from {{ package_name }}.application.models import ScopeRegistry, TaskQueue
    from {{ package_name }}.application.services import (
        HealthService,
{% if include_example_endpoint %}
        ItemService,
{% endif %}
        TaskDispatcher,
    )
{% if enable_azure_auth %}
    from fastapi_azure_auth import SingleTenantAzureAuthorizationCodeBearer

{% endif %}
    from {{ package_name }}.core.config import Settings
    from {{ package_name }}.database.session import DatabaseSessionManager


@dataclass(slots=True)
class ServiceContainer:
    """Stores dependency-injected services.

    Attributes:
        settings (Settings): Runtime settings.
        session_manager (DatabaseSessionManager): Async SQLAlchemy session manager.
        scope_registry (ScopeRegistry): Configured scope registry.
        health_service (HealthService): Health application service.
{% if include_example_endpoint %}
        item_service (ItemService): Example item application service.
{% endif %}
        task_dispatcher (TaskDispatcher): Long-running task dispatcher.
        task_queue (TaskQueue): Queue backend adapter.
{% if enable_azure_auth %}
        azure_scheme (SingleTenantAzureAuthorizationCodeBearer): JWT-validation
            dependency, built from this container's own settings.
{% endif %}
    """

    settings: Settings
    session_manager: DatabaseSessionManager
    scope_registry: ScopeRegistry
    health_service: HealthService
{% if include_example_endpoint %}
    item_service: ItemService
{% endif %}
    task_dispatcher: TaskDispatcher
    task_queue: TaskQueue
{% if enable_azure_auth %}
    azure_scheme: SingleTenantAzureAuthorizationCodeBearer
{% endif %}

    async def shutdown(self) -> None:
        """Releases container resources.

        Returns:
            None: Queue and database resources are released in-place.
        """

        await self.task_queue.close()
        await self.session_manager.dispose()


class ContainerState(TypedDict):
    """Types the ASGI scope state `main.lifespan` yields.

    Attributes:
        container (ServiceContainer): Application service container.
    """

    container: ServiceContainer


def get_container(request: Request) -> ServiceContainer:
    """Returns the application container.

    Defined here (rather than in `application/dependencies.py`) so modules
    that need request-scoped access to the container — like `core/auth.py`
    — can depend on it without importing from `application/dependencies.py`
    and creating a circular import.

    Args:
        request (Request): Current request. Keep this unparameterized —
            `Request[ContainerState]` breaks FastAPI's special-cased
            injection of the raw ASGI request.

    Returns:
        ServiceContainer: Application service container.
    """

    return cast(ServiceContainer, request.state.container)


ContainerDep = Annotated[ServiceContainer, Depends(get_container)]
