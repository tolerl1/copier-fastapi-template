from {{ package_name }}.application.models import Item


class ItemDTO(BaseModel):
    """Represents an example item.

    Attributes:
        id (str): Item identifier.
        name (str): Item name.
        description (str): Item description.
    """

    id: str
    name: str
    description: str

    @classmethod
    def from_item(cls, item: Item) -> ItemDTO:
        """Converts a domain item to its response representation.

        Args:
            item (Item): Domain item.

        Returns:
            ItemDTO: Response representation of the item.
        """

        return cls(id=item.id, name=item.name, description=item.description)


class PaginatedItemsDTO(BaseModel):
    """Represents a paginated item list.

    Attributes:
        items (list[ItemDTO]): Items for the current page.
        page (int): One-based page number.
        page_size (int): Page size after validation.
        total (int): Total number of items before pagination.
    """

    items: list[ItemDTO]
    page: int
    page_size: int
    total: int
{% endif %}


{% if enable_azure_auth %}
class CurrentUserDTO(BaseModel):
    """Represents the authenticated caller.

    Attributes:
        oid (str | None): Object ID of the user or service principal.
        name (str | None): Display name.
        preferred_username (str | None): UPN or email-like identifier.
        roles (list[str]): App roles granted to the caller.
    """

    oid: str | None
    name: str | None
    preferred_username: str | None
    roles: list[str]

    @classmethod
    def from_user(cls, user: User) -> CurrentUserDTO:
        """Builds the response representation from a validated Entra ID user.

        Args:
            user (User): Caller resolved by `azure_scheme`.

        Returns:
            CurrentUserDTO: Response representation of the caller.
        """

        return cls(
            oid=user.oid,
            name=user.name,
            preferred_username=user.preferred_username,
            roles=user.roles,
        )


