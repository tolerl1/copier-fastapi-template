_MAX_PAYLOAD_BYTES = 64 * 1024


class DispatchTaskRequest(BaseModel):
    """Describes a long-running task request.

    Attributes:
        scope (str): Target scope name.
        name (str): Task name.
        payload (dict[str, Any]): Task payload, capped at
            `_MAX_PAYLOAD_BYTES` serialized to guard the queue backend
            against unbounded messages.
    """

    scope: str
    name: str
    payload: dict[str, Any] = Field(default_factory=dict)

    @field_validator("payload")
    @classmethod
    def _limit_payload_size(cls, payload: dict[str, Any]) -> dict[str, Any]:
        """Rejects payloads whose serialized JSON exceeds the size cap.

        Args:
            payload (dict[str, Any]): Task payload to validate.

        Returns:
            dict[str, Any]: The unchanged payload, once validated.

        Raises:
            ValueError: If the serialized payload exceeds `_MAX_PAYLOAD_BYTES`.
        """

        size = len(json.dumps(payload).encode())
        if size > _MAX_PAYLOAD_BYTES:
            msg = f"payload is {size} bytes, over the {_MAX_PAYLOAD_BYTES}-byte limit"
            raise ValueError(msg)
        return payload


class DispatchTaskResponse(BaseModel):
    """Represents a queued task response.

    Attributes:
        task_id (str): Queued task identifier.
        scope (str): Normalized scope name.
        name (str): Task name.
        queue_backend (str): Backend that accepted the task.
    """

    task_id: str
    scope: str
    name: str
    queue_backend: str
