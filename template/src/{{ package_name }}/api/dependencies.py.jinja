from fastapi_azure_auth.user import User
{% endif %}
from sqlalchemy.ext.asyncio import AsyncSession

from {{ package_name }}.api.models import UnknownScopeError
from {{ package_name }}.api.services import HealthService, {% if include_example_endpoint %}ItemService, {% endif %}TaskDispatcher
