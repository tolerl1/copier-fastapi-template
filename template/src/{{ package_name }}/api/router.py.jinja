"""FastAPI router definitions."""

from __future__ import annotations

from fastapi import (
    APIRouter,
{% if enable_azure_auth %}
    Depends,
{% endif %}
)

from {{ package_name }}.application.dependencies import (
{% if enable_azure_auth %}
    AdminUserDep,
    CurrentUserDep,
{% endif %}
    HealthServiceDep,
    TaskDispatcherDep,
    raise_unknown_scope,
)
from {{ package_name }}.application.models import UnknownScopeError
from {{ package_name }}.application.schemas import (
{% if enable_azure_auth %}
    CurrentUserDTO,
{% endif %}
    DispatchTaskRequest,
    DispatchTaskResponse,
    HealthDTO,
)
{% if include_example_endpoint %}
from {{ package_name }}.api.items.router import items_router
{% endif %}
{% if enable_azure_auth %}
from {{ package_name }}.core.auth import get_current_user
{% endif %}

system_router = APIRouter(tags=["system"])
{% if enable_azure_auth %}
auth_router = APIRouter(prefix="/auth", tags=["auth"])
{% endif %}
tasks_router = APIRouter(
    prefix="/tasks",
    tags=["tasks"],
{% if enable_azure_auth %}
    dependencies=[Depends(get_current_user)],
{% endif %}
)


@system_router.get("/health")
async def health_check(health_service: HealthServiceDep) -> HealthDTO:
    """Returns the application health status.

    Args:
        health_service (HealthService): Injected health service.

    Returns:
        HealthDTO: Current health snapshot.
    """

    return await health_service.read()


{% if enable_azure_auth %}
@auth_router.get("/me")
async def whoami(user: CurrentUserDep) -> CurrentUserDTO:
    """Returns the authenticated caller's identity and app roles.

    Demonstrates the baseline "any valid Entra ID token" pattern — swap
    `CurrentUserDep` for your own dependency (or add `require_role(...)`
    checks) to require specific app roles per route, as `/auth/admin` below
    does.

    Args:
        user (User): Caller resolved by `get_current_user`.

    Returns:
        CurrentUserDTO: The caller's identity and app roles.
    """

    return CurrentUserDTO.from_user(user)


@auth_router.get("/admin")
async def admin_only(user: AdminUserDep) -> CurrentUserDTO:
    """Returns the caller's identity, but only if they hold the Admin role.

    Demonstrates `require_role(...)`: this route 403s for any authenticated
    caller whose token's `roles` claim doesn't include "Admin".

    Args:
        user (User): Caller resolved by `require_admin_role`.

    Returns:
        CurrentUserDTO: The caller's identity and app roles.
    """

    return CurrentUserDTO.from_user(user)


{% endif %}
@tasks_router.post("/dispatch", status_code=202)
async def dispatch_task(
    request: DispatchTaskRequest,
    dispatcher: TaskDispatcherDep,
) -> DispatchTaskResponse:
    """Dispatches a long-running task.

    Args:
        request (DispatchTaskRequest): Task request body.
        dispatcher (TaskDispatcher): Injected task dispatcher.

    Returns:
        DispatchTaskResponse: Queued task response.

    Raises:
        HTTPException: If the scope is unknown.
    """

    try:
        return await dispatcher.dispatch(request)
    except UnknownScopeError as error:
        raise raise_unknown_scope(error) from error


router = APIRouter()
router.include_router(system_router)
{% if enable_azure_auth %}
router.include_router(auth_router)
{% endif %}
{% if include_example_endpoint %}
router.include_router(items_router)
{% endif %}
router.include_router(tasks_router)

__all__ = ["router"]
