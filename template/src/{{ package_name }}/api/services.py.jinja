class TaskDispatcher:
    """Queues long-running work to the configured backend.

    Attributes:
        _queue (TaskQueue): Queue backend abstraction.
        _queue_backend (str): Queue backend name.
        _scope_registry (ScopeRegistry): Configured scope registry.
    """

    def __init__(
        self,
        queue: TaskQueue,
        queue_backend: str,
        scope_registry: ScopeRegistry,
    ) -> None:
        """Creates the task dispatcher.

        Args:
            queue (TaskQueue): Queue backend abstraction.
            queue_backend (str): Queue backend name.
            scope_registry (ScopeRegistry): Configured scope registry.

        Returns:
            None: The dispatcher is initialized in-place.
        """

        self._queue = queue
        self._queue_backend = queue_backend
        self._scope_registry = scope_registry

    async def dispatch(self, request: DispatchTaskRequest) -> DispatchTaskResponse:
        """Queues a long-running task.

        Args:
            request (DispatchTaskRequest): Task request.

        Returns:
            DispatchTaskResponse: Queued task response.

        Raises:
            UnknownScopeError: If the target scope is not registered.
        """

        if not self._scope_registry.has(request.scope):
            msg = f"Unknown scope: {request.scope}"
            raise UnknownScopeError(msg)
        task = build_task(request.scope, request.name, request.payload)
        LOGGER.log(
            TRACE_LEVEL,
            "Dispatching task %s to %s for scope %s",
            task.task_id,
            self._queue_backend,
            task.scope,
        )
        await self._queue.enqueue(task)
        return DispatchTaskResponse(
            task_id=task.task_id,
            scope=task.scope,
            name=task.name,
            queue_backend=self._queue_backend,
        )
