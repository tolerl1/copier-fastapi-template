"""FastAPI application entrypoint."""

from __future__ import annotations

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

import uvicorn
from fastapi import FastAPI

from {{ package_name }}.bootstrap import build_container
from {{ package_name }}.container import ContainerState
from {{ package_name }}.core.config import Settings
from {{ package_name }}.core.correlation import CorrelationIdMiddleware
from {{ package_name }}.core.logging import configure_logging
{% if enable_telemetry %}
from {{ package_name }}.core.telemetry import configure_telemetry
{% endif %}
from {{ package_name }}.routes.router import router


def create_app(settings: Settings | None = None) -> FastAPI:
    """Builds the FastAPI application.

    Args:
        settings (Settings | None): Optional settings override.

    Returns:
        FastAPI: Configured FastAPI application.
    """

    resolved_settings = settings or Settings()
    configure_logging(resolved_settings.log_level)

    @asynccontextmanager
    async def lifespan(app: FastAPI) -> AsyncIterator[ContainerState]:
        """Builds and tears down the service container around the app's life.

        Args:
            app (FastAPI): FastAPI application.

        Returns:
            AsyncIterator[ContainerState]: State merged into `request.state`.
        """

        container = build_container(resolved_settings)
        yield {"container": container}
        await container.shutdown()

    app = FastAPI(
        title=resolved_settings.app_name,
        lifespan=lifespan,
{% if enable_azure_auth %}
        swagger_ui_oauth2_redirect_url="/oauth2-redirect",
        swagger_ui_init_oauth={
            "usePkceWithAuthorizationCodeGrant": True,
            "clientId": resolved_settings.azure_openapi_client_id
            or resolved_settings.azure_client_id,
        },
{% endif %}
    )
    app.add_middleware(CorrelationIdMiddleware)
    app.include_router(router)
{% if enable_telemetry %}
    configure_telemetry(app, resolved_settings)
{% endif %}
    return app


app = create_app()


def serve() -> None:
    """Runs the application with Uvicorn.

    Returns:
        None: Uvicorn is started in-process.
    """

    settings = Settings()
    uvicorn.run(
        "{{ package_name }}.main:app",
        host=settings.host,
        port=settings.port,
        reload=False,
    )
