"""FastAPI application entrypoint."""

from __future__ import annotations

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

import uvicorn
from fastapi import FastAPI

from {{ package_name }}.bootstrap import build_container
from {{ package_name }}.core.config import Settings
from {{ package_name }}.core.correlation import CorrelationIdMiddleware
from {{ package_name }}.core.logging import configure_logging
from {{ package_name }}.core.telemetry import configure_telemetry
from {{ package_name }}.routes.router import router


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    """Manages startup and shutdown resources.

    Args:
        app (FastAPI): FastAPI application.

    Returns:
        AsyncIterator[None]: Lifespan context manager.
    """

    yield
    await app.state.container.shutdown()


def create_app(settings: Settings | None = None) -> FastAPI:
    """Builds the FastAPI application.

    Args:
        settings (Settings | None): Optional settings override.

    Returns:
        FastAPI: Configured FastAPI application.
    """

    resolved_settings = settings or Settings()
    configure_logging(resolved_settings.log_level)
    app = FastAPI(title=resolved_settings.app_name, lifespan=lifespan)
    app.state.container = build_container(resolved_settings)
    app.add_middleware(CorrelationIdMiddleware)
    app.include_router(router)
    configure_telemetry(app, resolved_settings)
    return app


app = create_app()


def serve() -> None:
    """Runs the application with Uvicorn.

    Returns:
        None: Uvicorn is started in-process.
    """

    settings = app.state.container.settings
    uvicorn.run(
        "{{ package_name }}.main:app",
        host=settings.host,
        port=settings.port,
        reload=False,
    )
