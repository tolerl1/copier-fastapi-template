# Copy this file to .env and adjust values for your environment.
# All variables are prefixed with {{ env_prefix }} (see src/{{ package_name }}/core/config.py).

{{ env_prefix }}APP_NAME={{ project_name }}
{{ env_prefix }}ENVIRONMENT=development

# Interface and port used by `uv run {{ package_slug }}` (uvicorn.run).
{{ env_prefix }}HOST=0.0.0.0
{{ env_prefix }}PORT=8000

# Async SQLAlchemy connection string (asyncpg driver required).
# Matches the "db" service in docker-compose.yml when published on localhost:5432.
{{ env_prefix }}DATABASE_URL=postgresql+asyncpg://{{ package_name }}:{{ package_name }}@localhost:5432/{{ package_name }}

# Root logging level. TRACE is a custom level below DEBUG.
{{ env_prefix }}LOG_LEVEL=INFO
{% if enable_telemetry %}

# OpenTelemetry tracing.
{{ env_prefix }}TELEMETRY_ENABLED=true
# Leave unset to export spans to the console instead of an OTLP collector.
# A bare collector base URL (e.g. http://collector:4318) is fine — the
# "v1/traces" signal path is appended automatically if not already present.
{{ env_prefix }}OTLP_ENDPOINT=
{% endif %}

# Long-running task queue backend: memory | redis | azure_storage_queue
{{ env_prefix }}QUEUE_BACKEND=memory
{{ env_prefix }}QUEUE_NAME=long-running-tasks
{{ env_prefix }}REDIS_URL=redis://localhost:6379/0
# Required only when {{ env_prefix }}QUEUE_BACKEND=azure_storage_queue.
# Also requires the `azure` extra: `uv sync --extra azure`.
{{ env_prefix }}AZURE_STORAGE_QUEUE_CONNECTION_STRING=
{% if enable_azure_auth %}

# Azure Entra ID (single-tenant). Both are required — the app won't start
# without them. Tenant ID is your Entra ID directory; client ID is this
# API's own app registration (not a client app's).
{{ env_prefix }}AZURE_TENANT_ID=
{{ env_prefix }}AZURE_CLIENT_ID=
# Optional: only set this if Swagger UI's "Authorize" button should use a
# separate public client (SPA) app registration for its PKCE login flow
# instead of AZURE_CLIENT_ID.
{{ env_prefix }}AZURE_OPENAPI_CLIENT_ID=
{% endif %}

# Bounded contexts (JSON array). Uncomment to override the defaults in core/config.py.
# {{ env_prefix }}SCOPES=[{"name":"identity","description":"Authentication and authorization."}]
