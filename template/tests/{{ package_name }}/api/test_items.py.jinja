@pytest.mark.asyncio
async def test_get_item_service_returns_container_owned_service() -> None:
    """Verifies the item dependency returns the container-managed service.

    Returns:
        None: Assertions validate dependency injection behavior.
    """

    container = build_container(
        Settings(
{% if enable_telemetry %}
            telemetry_enabled=False,
{% endif %}
            queue_backend="memory",
        )
    )

    service = get_item_service(container)

    assert isinstance(service, ItemService)
    assert service is container.item_service
    await container.shutdown()
