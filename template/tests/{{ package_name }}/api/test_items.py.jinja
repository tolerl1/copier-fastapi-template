@pytest.mark.asyncio
async def test_items_endpoint_returns_example_items({% if enable_azure_auth %}app, {% endif %}client) -> None:
    """Verifies the items endpoint.

    Args:
        client: Async test client.

    Returns:
        None: Assertions validate the endpoint response.
    """
{% if enable_azure_auth %}
    app.dependency_overrides[get_current_user] = lambda: object()
{% endif %}

    async with client.get("/items") as response:
        payload = await response.json()

        assert response.status == 200
        assert payload["page_size"] == 20
        assert len(payload["items"]) == 3
        assert [item["name"] for item in payload["items"]] == [
            "Example Item 1",
            "Example Item 2",
            "Example Item 3",
        ]


