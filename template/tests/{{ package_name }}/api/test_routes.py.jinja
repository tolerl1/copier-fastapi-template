@pytest.mark.asyncio
async def test_health_check_endpoint(client) -> None:
    """Verifies the health endpoint.

    Args:
        client: Async test client.

    Returns:
        None: Assertions validate the endpoint response.
    """

    async with client.get("/health") as response:
        payload = await response.json()

        assert response.status == 200
        assert payload["status"] == "ok"
        assert payload["queue_backend"] == "memory"
        assert payload["database_healthy"] is True


