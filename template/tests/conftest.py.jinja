@pytest_asyncio.fixture
async def client(app: FastAPI) -> AsyncIterator[aiohttp.ClientSession]:
    """Creates an async API client.

    Args:
        app (FastAPI): Test FastAPI application.

    Returns:
        AsyncIterator[aiohttp.ClientSession]: HTTP client for the test server.
    """

    port = find_free_port()
    server = uvicorn.Server(
        uvicorn.Config(app=app, host="127.0.0.1", port=port, log_level="warning")
    )
    server_task = asyncio.create_task(server.serve())

    for _ in range(200):
        if server.started:
            break
        await asyncio.sleep(0.01)
    else:
        msg = "Uvicorn test server did not start."
        raise RuntimeError(msg)

    async with aiohttp.ClientSession(
        base_url=f"http://127.0.0.1:{port}",
    ) as client_session:
        yield client_session

    server.should_exit = True
    await server_task
